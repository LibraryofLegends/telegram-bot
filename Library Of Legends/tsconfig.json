{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/main.ts",
    "src/config/**/*.ts",
    "src/framework/telegram/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}