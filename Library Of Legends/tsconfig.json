{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "composite": false,

    "baseUrl": ".",

    "types": [
      "node"
    ]
  },

  "include": [
    "applications/**/*",
    "framework/**/*",
    "providers/**/*",
    "features/**/*",
    "packages/**/*",
    "tools/**/*",
    "tests/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}