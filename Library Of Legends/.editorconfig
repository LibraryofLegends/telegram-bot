# File.............: .editorconfig
# Category.........: Editor Configuration
# File-ID..........: LOL-CONFIG-0006
# Version..........: 1.0.0
# Status...........: Stable
# ============================================================================

root = true

[*]

charset = utf-8

end_of_line = lf

insert_final_newline = true

trim_trailing_whitespace = true

indent_style = space

indent_size = 2

[*.md]

trim_trailing_whitespace = false

[*.json]

indent_size = 2

[*.yml]

indent_size = 2

[*.yaml]

indent_size = 2