{
  "name": "@library-of-legends/workspace",
  "version": "0.1.0",
  "description": "Library Of Legends - Professional Media Library Platform",
  "private": true,
  "type": "module",
  "author": {
    "name": "Mr. Library Of Legends"
  },
  "license": "MIT",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@lol/telegram-bot",
    "dev": "npm run dev --workspace=@lol/telegram-bot",
    "build": "npm run build --workspaces",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test",
    "clean": "node scripts/clean.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "media",
    "movies",
    "series",
    "library",
    "tmdb",
    "nodejs",
    "library-of-legends"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/library-of-legends/library-of-legends.git"
  },
  "bugs": {
    "url": "https://github.com/library-of-legends/library-of-legends/issues"
  },
  "homepage": "https://github.com/library-of-legends/library-of-legends",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}