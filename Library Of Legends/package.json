{
  "name": "library-of-legends",
  "version": "0.1.0",
  "private": true,

  "description": "Library Of Legends - Project Phoenix",

  "license": "MIT",

  "author": "Library Of Legends",

  "type": "module",

  "packageManager": "pnpm@10",

  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },

  "workspaces": [
    "applications/*",
    "framework/*",
    "providers/*",
    "features/*",
    "packages/*"
  ],

  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "clean": "turbo clean"
  },

  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}